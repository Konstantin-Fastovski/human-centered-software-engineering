@inproceedings{10.1145/3832783.3834377,
  author = {Tang, Ningzhi and Chen, Chaoran and Fang, Zihan and Xu, Gelei and
            Dhakal, Maria and Shi, Yiyu and McMillan, Collin and Huang, Yu and Li
            , Toby Jia-Jun},
  title = {Programming by Chat: A Large-Scale Behavioral Analysis of 11,579
           Real-World AI-Assisted IDE Sessions},
  year = {2026},
  isbn = {9798400728822},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3832783.3834377},
  doi = {10.1145/3832783.3834377},
  abstract = {IDE-integrated AI coding assistants, which operate
              conversationally within developers' working codebases with access
              to project context and multi-file editing, are rapidly reshaping
              software development. However, empirical investigation of this
              shift remains limited: existing studies largely rely on small-scale
              , controlled settings or analyze general-purpose chatbots rather
              than codebase-aware IDE workflows. We present, to the best of our
              knowledge, the first large-scale study of real-world conversational
              programming in IDE-native settings, analyzing 74,998 developer
              messages from 11,579 chat sessions across 1,300 repositories and
              899 developers using Cursor and GitHub Copilot. These chats were
              committed to public repositories as part of routine development,
              capturing in-the-wild behavior. Our findings reveal three shifts in
              how programming work is organized: conversational programming
              operates as progressive specification, with developers iteratively
              refining outputs rather than specifying complete tasks upfront;
              developers redistribute cognitive work to AI, delegating diagnosis,
              comprehension, and validation rather than engaging with code and
              outputs directly; and developers actively manage the collaboration,
              externalizing plans into persistent artifacts, and negotiating AI
              autonomy through context injection and behavioral constraints.
              These results provide foundational empirical insights into
              AI-assisted development and offer implications for the design of
              future programming environments.},
  booktitle = {Proceedings of the 41st IEEE/ACM International Conference on
               Automated Software Engineering},
  pages = {588–600},
  numpages = {13},
  keywords = {AI Coding Assistants, Behavioral Log Analysis, Conversational
              Programming, Empirical Software Engineering},
  location = {Munich, Germany},
  series = {ASE '26},
}

@inproceedings{10.1007/978-3-032-22937-3_5,
  author = "Moreira, Ezequiel Jos{\'e} Veloso Ferreira and Creissac Campos, Jos{
            \'e}",
  editor = "Maciel, Cristiano and Spano, Davide Lucio and Ardito, Carmelo and
            Freire, Andr{\'e} and Prates, Raquel",
  title = "AI in Formal IDEs: Improving Usability or Undermining Trust?",
  booktitle = "Blending Experiences in Interaction Design",
  year = "2026",
  publisher = "Springer Nature Switzerland",
  address = "Cham",
  pages = "54--63",
  abstract = "Formal methods provide rigorous approaches for specifying and
              verifying system behaviour, but their practical adoption is often
              limited by challenges related to usability and accessibility. While
              there has been growing recognition of the need to improve user
              experience in tools that support formal methods, significant
              barriers remain. At the same time, AI-powered features are becoming
              increasingly common in software development environments. This
              paper explores the potential of incorporating AI into formal
              methods tools, identifying potential opportunities for supporting
              tasks such as requirements elicitation, model construction, and
              result interpretation, as well as risks related to trust,
              explainability, and user understanding. By connecting ongoing
              concerns about the usability of formal methods with current
              developments in AI-assisted programming, we outline key
              considerations for analysing the responsible integration of AI into
              formal verification workflows.",
  isbn = "978-3-032-22937-3",
}

